# ==============================================================================
# AVEN INDUSTRIAL AUTOMATION ERP — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: This is a template with placeholder values. Never commit actual secret keys.
# Copy this file to .env.local for local development.

# 1. PostgreSQL Database Configuration (Neon Serverless / Supabase / AWS RDS / Local)
# In production (NODE_ENV=production), DATABASE_URL is strictly mandatory.
# Neon connection string example with TLS encryption enabled:
DATABASE_URL="postgresql://[user]:[password]@[neon-host].aws.neon.tech/[database]?sslmode=require"

# 2. Cloudinary Cloud Storage Configuration (Asset management & design drawing uploads)
# Ensure CLOUDINARY_FOLDER is kept as 'new_erp'
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_FOLDER="new_erp"

# 3. Chromium Browser Executable (Optional override for custom VPS / Docker / local environments)
# On Windows, system Chrome/Edge is auto-detected. On Linux VPS/Docker, /usr/bin/google-chrome is auto-detected.
# CHROME_PATH="/usr/bin/google-chrome-stable"

# 4. Next.js Runtime Settings
NODE_ENV="production"
PORT=3000
