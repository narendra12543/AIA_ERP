# ==============================================================================
# AVEN INDUSTRIAL AUTOMATION ERP — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: Safe placeholders only. Never commit actual secrets.
# Copy to .env.local for local development, or configure in Vercel Project Settings.

# 1. PostgreSQL Database Configuration (Existing Neon PostgreSQL)
# Required in production (NODE_ENV=production).
DATABASE_URL="postgresql://[user]:[password]@[neon-host].aws.neon.tech/[database]?sslmode=require"

# 2. Cloudinary Cloud Storage Configuration (Existing Cloudinary Integration)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_FOLDER="new_erp"

# 3. Enterprise Security, Encryption & RBAC (Newly Required)
# Generate independent 32-byte key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Preserve this exact key across all deployments; do not regenerate on redeploys.
SETTINGS_ENCRYPTION_KEY="your_64_hex_char_32_byte_random_encryption_key"
PASSWORD_EXPIRY_DAYS="15"
ENABLE_PASSWORD_EXPIRY="true"
ENABLE_RBAC_ENFORCEMENT="true"

# 4. Zoho Mail SMTP Integration (Optional — can also be configured in Admin Settings UI)
ZOHO_SMTP_HOST="smtp.zoho.in"
ZOHO_SMTP_PORT="465"
ZOHO_EMAIL="sales@avenautomation.in"
ZOHO_APP_PASSWORD="your_rotated_zoho_app_specific_password"
ZOHO_FROM_NAME="AVEN Industrial Automation"
ZOHO_DEFAULT_CC="info@avenautomation.in"

# Optional Zoho OAuth readiness (only if future Inbox/Sent API sync is enabled)
# ZOHO_OAUTH_CLIENT_ID="your_zoho_oauth_client_id"
# ZOHO_OAUTH_CLIENT_SECRET="your_zoho_oauth_client_secret"

# 5. AI Email Writing Assistant (Optional; local B2B engine works offline by default)
ENABLE_AI_ASSISTANT="true"
ALLOW_EXTERNAL_AI="false"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# 6. Optional Runtime Overrides
# NEXT_PUBLIC_APP_URL="https://erp.avenautomation.in"
# CHROME_PATH="/usr/bin/google-chrome-stable"
